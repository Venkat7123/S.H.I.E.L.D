# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Stub mode (the default in config.yaml) needs none of these.

LLM_MODE=stub

# Live mode only. Set the one matching config.yaml's llm.provider.
# Look up the current base URL and model id in the provider's own docs at build time.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Bedrock uses the standard AWS chain instead of an API key.
AWS_REGION=
